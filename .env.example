# Copiar como .env. No guardar credenciales ni la base de datos en Git.
PORT=3001
HOST=127.0.0.1
# En producción, usar HTTPS mediante proxy y definir:
# NODE_ENV=production
# PUBLIC_ORIGIN=https://tu-dominio.com
# DATA_DIR=/ruta/persistente/lebron

# Correo del dueño: limita el alta/vinculación a esa dirección (recomendado).
# ADMIN_EMAIL=tu-correo@ejemplo.com

# Envío de códigos: elegir Resend o SMTP. No hay códigos públicos de desarrollo.
# MAIL_PROVIDER=resend
# MAIL_FROM=LeBron <acceso@tu-dominio.com>
# RESEND_API_KEY=
# Alternativa SMTP (465 TLS o 587 STARTTLS obligatorio):
# MAIL_PROVIDER=smtp
# MAIL_FROM=LeBron <tu-correo@ejemplo.com>
# SMTP_HOST=smtp.ejemplo.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=

# Imágenes: bucket PRIVADO exclusivo de Lebron, sin usar el de comprobantes de Alianzas.
# En desarrollo sin claves se usa almacenamiento local; en producción se exige R2
# para nuevas subidas salvo que se elija IMAGE_STORAGE=local explícitamente.
# IMAGE_STORAGE=r2
# R2_ACCOUNT_ID=
# R2_BUCKET=lebron-catalogo
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Solo si un proxy inmediato de confianza SOBRESCRIBE X-Real-IP.
# Usar las IP exactas de ese proxy y bloquear el acceso directo a Node.
# No activar a ciegas ni confiar en X-Forwarded-For del cliente.
# TRUSTED_PROXY_IPS=127.0.0.1,::1,::ffff:127.0.0.1
